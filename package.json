{
  "name": "podwave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first podcast player, built to grow into transcription and bilingual subtitles.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"node server/index.js\" \"vite --config web/vite.config.js\"",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "express": "^4.21.2",
    "music-metadata": "^10.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  }
}
